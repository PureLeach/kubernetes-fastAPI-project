COMPOSE_PROJECT_NAME=storage_service

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Local development only: docker compose reads this file too.
SERVER_RELOAD=False

LOG_LEVEL_ROOT=INFO

ENABLE_METRICS=True

# Reject PUT bodies larger than this (bytes).
MAX_OBJECT_BYTES=1048576

# Background flush to disk; 0 disables it. Shutdown still writes a snapshot.
SNAPSHOT_INTERVAL_SECONDS=300
